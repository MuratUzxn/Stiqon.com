# Versions this project is developed and tested against (checked 2026-11-25).
#
# Every package below comes from a fixed address and is refused unless it matches
# the checksum given here. To move to another version, change the version and its
# checksum together. Language packs are the exception: their translators revise
# them without a new version number, so they cannot be pinned.

# https://downloads.wordpress.org/release/wordpress-<version>.zip
WORDPRESS_VERSION=7.1.5
WORDPRESS_SHA256=cd44160a3fcce179fe170331132fcfc05e84e2f9284e2aad38df2aea6edaeab1

# https://downloads.wordpress.org/plugin/<slug>.<version>.zip
WOOCOMMERCE_VERSION=11.3.1
WOOCOMMERCE_SHA256=1502600c738840f7f9ebfa2f11e1aaff087221a5fc5a2006c51be2d874ae2a09
GERMANIZED_VERSION=4.1.10
GERMANIZED_SHA256=65110bb905fdf4dbb6c9c34705f0c48fea5d42518189e1d8dad22db71258ea80

# WP-CLI, taken from one commit of github.com/wp-cli/builds: that address serves
# the same file for good, whatever is released later.
WP_CLI_VERSION=2.12.0
WP_CLI_COMMIT=d5d7fd865b49b8d09cece8361f4c8e508fce9cfa
WP_CLI_SHA512=be928f6b8ca1e8dfb9d2f4b75a13aa4aee0896f8a9a0a1c45cd5d2c98605e6172e6d014dda2e27f88c98befc16c040cbb2bd1bfa121510ea5cdf5f6a30fe8832
