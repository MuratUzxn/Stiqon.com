# Entwicklungs-Vorlage. Für den Betrieb erzeugt `php artisan stiqon:install`
# eine eigene Produktions-.env (APP_ENV=production, APP_DEBUG=false).

APP_NAME=Stiqon
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8123

APP_LOCALE=de
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=de_DE

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Entwicklung und Tests: SQLite. Betrieb: MariaDB/MySQL.
DB_CONNECTION=sqlite
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=stiqon
# DB_USERNAME=stiqon
# DB_PASSWORD=

# Läuft ohne Datenbank-Sessions, ohne Cache-Server und ohne Queue-Worker.
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=file
QUEUE_CONNECTION=deferred
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

# Entwicklung: Mails landen im Log. Betrieb: SMTP (in der Verwaltung einstellbar).
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="shop@example.test"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
